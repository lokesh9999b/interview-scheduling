{
  "name": "grit-interview",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "db:postgres": "node scripts/use-postgres.mjs",
    "db:sqlite": "node scripts/use-sqlite.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "6.19.3",
    "clsx": "^2.1.1",
    "geist": "^1.5.1",
    "lucide-react": "^0.545.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "marked": "^18.2.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
